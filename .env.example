# None of these are required to run the app in dev mode — see README for
# what's stubbed. Fill these in as each integration gets wired up.

# Supabase (DESIGN.md §1, §3) — replaces src/lib/data + src/lib/session
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Document storage — uses the same Supabase project/keys above (a private
# "documents" Storage bucket), see src/lib/storage.ts. No separate env vars
# needed. DESIGN.md §5 originally specified Google Drive for this; switched
# to Supabase Storage since the project already runs on Supabase.

# Resend (DESIGN.md §7) — replaces the console.log stub in src/lib/email.ts
RESEND_API_KEY=
